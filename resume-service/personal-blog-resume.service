[Unit]
Description=Personal Blog Resume Repository
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=personal-blog-resumes
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=RESUME_HOST=127.0.0.1
Environment=RESUME_PORT=8091
Environment=RESUME_DATA_DIR=/var/lib/personal-blog-resumes
EnvironmentFile=/etc/personal-blog-resume.env
ExecStart=/usr/bin/python3 /opt/personal-blog-resume/resume_service.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
